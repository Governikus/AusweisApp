{
  "version": 6,
  "include": [
    "ci.json"
  ],
  "configurePresets": [
    {
      "name": "ci-win",
      "inherits": "ci-with-libs",
      "cacheVariables": {
        "WIN_SIGN_KEYSTORE": "$env{WIN_SIGN_KEYSTORE}",
        "WIN_SIGN_KEYSTORE_PSW": "$env{WIN_SIGN_KEYSTORE_PSW}",
        "WIN_SIGN_SUBJECT_NAME": "$env{WIN_SIGN_SUBJECT_NAME}"
      }
    },
    {
      "name": "ci-win-release",
      "inherits": "ci-win",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "MinSizeRel"
      }
    },
    {
      "name": "ci-win-debug",
      "inherits": "ci-win",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "DEBUG"
      }
    },
    {
      "name": "ci-win-arm64",
      "inherits": "ci-win",
      "cacheVariables": {
        "CMAKE_SYSTEM_NAME": "Windows",
        "CMAKE_SYSTEM_PROCESSOR": "ARM64"
      }
    },
    {
      "name": "ci-win-release-arm64",
      "inherits": "ci-win-arm64",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "MinSizeRel"
      }
    },
    {
      "name": "ci-win-debug-arm64",
      "inherits": "ci-win-arm64",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "DEBUG"
      }
    }
  ]
}
