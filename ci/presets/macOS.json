{
  "version": 6,
  "include": [
    "ci.json"
  ],
  "configurePresets": [
    {
      "name": "ci-macos",
      "inherits": "ci-with-libs",
      "generator": "Xcode"
    },
    {
      "name": "ci-macos-debug",
      "inherits": "ci-macos",
      "cacheVariables": {
        "BUILD_SHARED_LIBS": "ON",
        "SANITIZER": "ON"
      }
    },
    {
      "name": "ci-macos-release",
      "inherits": "ci-macos",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "MinSizeRel"
      }
    },
    {
      "name": "ci-macos-release-arm64",
      "inherits": "ci-macos-release",
      "cacheVariables": {
        "CMAKE_OSX_ARCHITECTURES": "arm64"
      }
    },
    {
      "name": "ci-macos-integrated",
      "inherits": "ci-with-libs",
      "cacheVariables": {
        "INTEGRATED_SDK": "ON",
        "SANITIZER": "ON"
      }
    }
  ]
}
