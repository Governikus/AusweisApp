@PACKAGE_INIT@

set(LIBS_GOVERNIKUS ON)
set(LIBS_SYSTEM @CMAKE_SYSTEM_NAME@)
set(LIBS_BUILD_DATE "@stamp@")
set(LIBS_REVISION "@dvcs_revision@")
set(LIBS_BRANCH "@dvcs_branch@")
set(LIBS_PHASE "@dvcs_phase@")
set(LIBS_QT "@QT@")
set(LIBS_QT_PATCHES @QT_PATCHES@)
set(LIBS_OPENSSL "@OPENSSL@")
set(LIBS_OPENSSL_PATCHES @OPENSSL_PATCHES@)
set(LIBS_LLHTTP "@LLHTTP@")
set(LIBS_LLHTTP_PATCHES @LLHTTP_PATCHES@)
set(LIBS_TARBALL "@compressed_filename@")
set(LIBS_IDENTIFIER "@IDENTIFIER@")

if(@HAS_OSX_VARS_CONFIG@)
	if(NOT CMAKE_OSX_DEPLOYMENT_TARGET)
		set(CMAKE_OSX_DEPLOYMENT_TARGET "@CMAKE_OSX_DEPLOYMENT_TARGET@")
	endif()

	if(NOT CMAKE_OSX_ARCHITECTURES)
		set(CMAKE_OSX_ARCHITECTURES "@CMAKE_OSX_ARCHITECTURES@")
	endif()
endif()

check_required_components(Governikus)
