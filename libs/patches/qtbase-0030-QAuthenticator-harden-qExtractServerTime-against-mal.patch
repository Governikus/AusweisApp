From 75cd1c5b66a3210b137ad9d27bcc6c8ba5c36763 Mon Sep 17 00:00:00 2001
From: Mate Barany <mate.barany@qt.io>
Date: Fri, 12 Jun 2026 16:47:55 +0200
Subject: QAuthenticator: harden qExtractServerTime against malformed input
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Replace QDataStream with direct pointer arithmetic and
qFromLittleEndian for walking AV_PAIR structures. Add bounds checks
before every pointer advance, validate that MsvAvTimestamp is exactly
8 bytes per MS-NLMP section 2.2.2.1.

Malformed or truncated timestamps cause the function to return an
empty QByteArray, which makes the existing caller fall back to the
current system time — the same path taken when the server omits
the timestamp entirely. This preserves the current behaviour rather
than failing the authentication outright.

Add test cases for malformed targetInfo inputs (wrong avLen,
truncated buffer, too-short header, avLen exceeding buffer, empty
buffer) to verify no crash and that the fallback path produces a
valid Phase 3 response.

Task-number: QTBUG-147529
Pick-to: 6.12 6.11
Change-Id: I5bdb4e4440460d0770f5d145238c4db39cad06e3
Reviewed-by: Mårten Nordheim <marten.nordheim@qt.io>
Reviewed-by: Thiago Macieira <thiago.macieira@intel.com>
(cherry picked from commit eb91758e006472b0f40304219aae09e69564c0fa)
---
 src/network/kernel/qauthenticator.cpp         | 31 +++---
 .../qauthenticator/tst_qauthenticator.cpp     | 99 +++++++++++++++++++
 2 files changed, 118 insertions(+), 12 deletions(-)

diff --git x/qtbase/src/network/kernel/qauthenticator.cpp y/qtbase/src/network/kernel/qauthenticator.cpp
index 7be1d7fe3aac7fe2c5b694b5da73ac25750d972c..5c476f898023224a463df825723840f09bd09d14 100644
--- x/qtbase/src/network/kernel/qauthenticator.cpp
+++ y/qtbase/src/network/kernel/qauthenticator.cpp
@@ -1000,6 +1000,8 @@ QByteArray QAuthenticatorPrivate::digestMd5Response(QByteArrayView challenge, QB
 const int blockSize = 64; //As per RFC2104 Block-size is 512 bits
 const quint8 respversion = 1;
 const quint8 hirespversion = 1;
+// FILETIME: two 32-bit values = 8 bytes (MS-DTYP section 2.3.3)
+static constexpr quint16 NtlmFileTimeSize = 8;
 
 /* usage:
    // fill up ctx with what we know.
@@ -1326,24 +1328,29 @@ static QByteArray clientChallenge(const QAuthenticatorPrivate *ctx)
 static QByteArray qExtractServerTime(const QByteArray& targetInfoBuff)
 {
     QByteArray timeArray;
-    QDataStream ds(targetInfoBuff);
-    ds.setByteOrder(QDataStream::LittleEndian);
-
+    const char *ptr = targetInfoBuff.constBegin();
+    const char *end = targetInfoBuff.constEnd();
     quint16 avId;
     quint16 avLen;
 
-    ds >> avId;
-    ds >> avLen;
-    while(avId != 0) {
+    while (end - ptr >= 4) {
+        avId = qFromLittleEndian<quint16>(ptr + 0);
+        avLen = qFromLittleEndian<quint16>(ptr + 2);
+        ptr += 4;
+
         if (avId == AVTIMESTAMP) {
-            timeArray.resize(avLen);
-            //avLen size of QByteArray is allocated
-            ds.readRawData(timeArray.data(), avLen);
+            if (avLen != NtlmFileTimeSize)
+                break;
+            if (end - ptr < NtlmFileTimeSize)
+                break;
+
+            timeArray.assign(ptr, ptr + NtlmFileTimeSize);
             break;
         }
-        ds.skipRawData(avLen);
-        ds >> avId;
-        ds >> avLen;
+
+        if (avLen > end - ptr)
+            break;
+        ptr += avLen;
     }
     return timeArray;
 }
