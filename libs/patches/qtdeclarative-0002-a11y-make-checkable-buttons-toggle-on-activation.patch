diff --git x/qtdeclarative/src/quicktemplates/qquickabstractbutton.cpp y/qtdeclarative/src/quicktemplates/qquickabstractbutton.cpp
index 709508483f0f14b7b65afec9119f92b0edb25a06..9e74fefe3903005058c6d3e0cc22625863cd0037 100644
