-    auto it = m_fileSelectedTypes.find(name);
-    if (it == m_fileSelectedTypes.end()) {
+    auto [it, end] = m_fileSelectedTypes.equal_range(name);
+    auto match = std::find_if(it, end, [&fileSelector](const FileSelectedType &entry) {
