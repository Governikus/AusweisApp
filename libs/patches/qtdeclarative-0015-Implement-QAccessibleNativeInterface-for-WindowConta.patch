diff --git x/qtdeclarative/src/quick/accessible/qaccessiblequickwindowcontainer.cpp y/qtdeclarative/src/quick/accessible/qaccessiblequickwindowcontainer.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..99c00224250386292fd8dfd4f25856dba75bce56
--- /dev/null
+++ y/qtdeclarative/src/quick/accessible/qaccessiblequickwindowcontainer.cpp
@@ -0,0 +1,35 @@
+// Copyright (C) 2026 The Qt Company Ltd.
+// SPDX-License-Identifier: LicenseRef-Qt-Commercial OR LGPL-3.0-only OR GPL-2.0-only OR GPL-3.0-only
+// Qt-Security score:significant reason:default
+
+#include "qaccessiblequickwindowcontainer_p.h"
+
+QT_BEGIN_NAMESPACE
+
+#if QT_CONFIG(accessibility)
+
+QAccessibleQuickWindowContainer::QAccessibleQuickWindowContainer(
+        QQuickWindowContainer *windowContainer)
+    : QAccessibleQuickItem(windowContainer)
+{
+}
+
+WId QAccessibleQuickWindowContainer::getNativeHandle() const
+{
+    if (auto *container = windowContainer())
+        return container->containedWindow()->winId();
+
+    return WId(0);
+}
+
+void *QAccessibleQuickWindowContainer::interface_cast(QAccessible::InterfaceType t)
+{
+    if (t == QAccessible::NativeInterface)
+        return static_cast<QAccessibleNativeInterface *>(this);
+
+    return nullptr;
+}
+
+#endif // accessibility
+
+QT_END_NAMESPACE
