+++ y/qtdeclarative/src/quick/accessible/qaccessiblequickwindowcontainer_p.h
@@ -0,0 +1,50 @@
+// Copyright (C) 2026 The Qt Company Ltd.
+// SPDX-License-Identifier: LicenseRef-Qt-Commercial OR LGPL-3.0-only OR GPL-2.0-only OR GPL-3.0-only
+// Qt-Security score:significant reason:default
+
+#ifndef QACCESSIBLEQUICKWINDOWCONTAINER_H
+#define QACCESSIBLEQUICKWINDOWCONTAINER_H
+
+//
+//  W A R N I N G
+//  -------------
+//
+// This file is not part of the Qt API.  It exists purely as an
+// implementation detail.  This header file may change from version to
+// version without notice, or even be removed.
+//
+// We mean it.
+//
+
+#include "qaccessiblequickitem_p.h"
+
+#include <QtQuick/private/qquickwindowcontainer_p.h>
+
+QT_BEGIN_NAMESPACE
+
+#if QT_CONFIG(accessibility)
+
+class Q_QUICK_EXPORT QAccessibleQuickWindowContainer : public QAccessibleQuickItem,
+                                                       public QAccessibleNativeInterface
+{
+public:
+    QAccessibleQuickWindowContainer(QQuickWindowContainer *windowContainer);
+
+    // QAccessibleNativeInterface
+    virtual WId getNativeHandle() const override;
+
+protected:
+    void *interface_cast(QAccessible::InterfaceType t) override;
+
+private:
+    QQuickWindowContainer *windowContainer() const
+    {
+        return static_cast<QQuickWindowContainer *>(item());
+    }
+};
+
+#endif // accessibility
+
+QT_END_NAMESPACE
+
+#endif // QACCESSIBLEQUICKWINDOWCONTAINER_H
