diff --git x/qtbase/src/testlib/qtestresult.cpp y/qtbase/src/testlib/qtestresult.cpp
index c88aeacce7fe9a7736a33fed60699000ebd96864..07eaf428b9443eee4b129a40b1c8ccb8127e90d3 100644
